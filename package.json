{
  "name": "open-accessibility-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn a wall of accessibility findings into a small, role-aware set of explainable remediation tasks with evidence, context, guidance, and validation.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run verify:data && node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "verify:data": "node scripts/verify-data-provenance.js",
    "build:data": "node scripts/build-arrm-data.js && node scripts/build-guidance.js && node scripts/build-rag-index.js"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "remediation",
    "wcag",
    "arrm",
    "open-scans",
    "oobee"
  ],
  "author": "Open Accessibility Workbench Contributors",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.4"
  }
}
